# ALIENTEK DNESP32S3 BOX3: ESP32-S3R8 + BY25Q128ES
CONFIG_IDF_TARGET="esp32s3"

# External 16 MiB quad-SPI flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Use the project partition table for internal Flash FATFS and LittleFS storage.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-S3R8 in-package 8 MiB octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# BOX3 onboard GC0308 camera: QVGA RGB565 frames are stored in PSRAM.
CONFIG_GC0308_SUPPORT=y
CONFIG_GC_SENSOR_SUBSAMPLE_MODE=y

# The board's Type-C connector is wired to GPIO19/GPIO20 (native USB).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# LVGL uses RGB565 and the built-in ASCII font for the BOX3 button example.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE=65536
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_BUTTON=y
CONFIG_LV_USE_LABEL=y
# The application supplies its own UI; do not compile LVGL's example sources.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
