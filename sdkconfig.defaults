# ALIENTEK DNESP32S3 BOX3：ESP32-S3R8 + BY25Q128ES
CONFIG_IDF_TARGET="esp32s3"

# 16 MiB 外部 Quad SPI Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 使用项目分区表，为片内 Flash FATFS 和 LittleFS 分配空间。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-S3R8 内置 8 MiB Octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# 4 KiB 及以下的普通 malloc 优先使用片内 RAM；更大的普通分配优先使用
# PSRAM。显式要求 MALLOC_CAP_INTERNAL/DMA 的驱动内存不受此阈值影响。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# WiFi/LwIP 的可外移缓冲优先放入 PSRAM；DMA 必需的固定缓冲仍保留片内 RAM。
# 本项目同时常驻 BLE 和 ESP-SR，使用中等吞吐配置：RX/TX 固定缓冲和 BA 窗口
# 各为 4，动态 RX 为 8。数量满足 static RX >= BA window，适合控制、普通网页
# 和少量 AP 客户端；代价是峰值 WiFi 吞吐低于 ESP-IDF 默认配置。
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# 账号由 flash_nvs.c 保存，WiFi 驱动自身不再读写另一份 NVS 配置。
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# 本项目优先保留片内 RAM，WiFi 高频路径从 Flash 执行；峰值吞吐会略微下降。
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# speech_feed、speech_detect 和 speech_action 的任务栈明确分配到 PSRAM。
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# 将 ESP-IDF 明确标记为可外移的蓝牙 BSS 放到 PSRAM，给 ESP-SR 保留片内 RAM。
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# ESP32-S3 只启用 BLE NimBLE Observer。扫描服务不连接、不广播、不配对；NimBLE
# 主机动态内存和可外移 BSS 放入 PSRAM。控制器只保留传统 BLE 扫描，关闭连接、
# 广播、加密、DTM 和 BLE 5 扩展功能，并把控制器代码放到 Flash，减少片内 RAM。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_SECURITY_ENABLE is not set
# CONFIG_BT_NIMBLE_GAP_SERVICE is not set
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set
# CONFIG_BT_NIMBLE_DTM_MODE_TEST is not set
CONFIG_BT_CTRL_BLE_MAX_ACT=1
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50
# CONFIG_BT_CTRL_BLE_SCAN_DUPL is not set
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
# CONFIG_BT_CTRL_DTM_ENABLE is not set
# CONFIG_BT_CTRL_BLE_MASTER is not set
CONFIG_BT_CTRL_BLE_SCAN=y
# CONFIG_BT_CTRL_BLE_SECURITY_ENABLE is not set
# CONFIG_BT_CTRL_BLE_ADV is not set

# SoftAP 客户端通过 STA 访问外网：IP_FORWARD 负责跨接口转发，IPv4 NAPT
# 把多个 AP 私网地址转换为 STA 地址；项目不需要从外网主动映射端口。
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
# CONFIG_LWIP_IPV4_NAPT_PORTMAP is not set

# BOX3 板载 GC0308，QVGA RGB565 帧缓冲区放入 PSRAM。
CONFIG_GC0308_SUPPORT=y
CONFIG_GC_SENSOR_SUBSAMPLE_MODE=y
# 24 KiB 上限实际分配 3 x 7680 = 23040 字节片内 DMA 缓冲。
# 官方驱动会创建 2 个事件槽，可同时保存帧尾 EOF 和 VSYNC，避免队列溢出。
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=24576

# Type-C 接口连接 GPIO19/GPIO20，使用原生 USB 控制台。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# ESP-SR 模型保存在 model 分区：WakeNet 唤醒词“你好小鑫”，MultiNet5 中文
# 命令模型在运行时注册“开/关红灯”短语。WebRTC NS/VAD 不额外占用模型分区。
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_WN_WN9_NIHAOXIAOXIN_TTS=y
CONFIG_SR_MN_CN_MULTINET5_RECOGNITION_QUANT8=y

# LVGL 使用 UTF-8；FreeType 从 /sdcard/font/font.ttf 加载中文字体。
#
# 不使用 LVGL 默认的 64 KiB 固定内存池。页面控件、样式、定时器和文件列表
# 通过 main/app/src/lvgl_memory.c 明确从 PSRAM 分配；FreeType 自身仍使用标准
# malloc，保持其小块解析内存位于内部 RAM。
CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_FREETYPE=y
# CONFIG_LV_FREETYPE_USE_LVGL_PORT is not set

# SD 音乐目录允许使用中文长文件名，VFS 接口统一传递 UTF-8。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# 通过标准文件接口访问已挂载到 /sdcard 的 SD 卡。
CONFIG_LV_FS_DEFAULT_DRIVER_LETTER=83
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH=""
CONFIG_LV_FS_STDIO_CACHE_SIZE=4096

# 界面由应用程序创建，不编译 LVGL 示例和演示程序。
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
