# ALIENTEK DNESP32S3 BOX3：ESP32-S3R8 + BY25Q128ES
CONFIG_IDF_TARGET="esp32s3"

# 16 MiB 外部 Quad SPI Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 使用项目分区表，为片内 Flash FATFS 和 LittleFS 分配空间。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-S3R8 内置 8 MiB Octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# BOX3 板载 GC0308，QVGA RGB565 帧缓冲区放入 PSRAM。
CONFIG_GC0308_SUPPORT=y
CONFIG_GC_SENSOR_SUBSAMPLE_MODE=y

# Type-C 接口连接 GPIO19/GPIO20，使用原生 USB 控制台。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# LVGL 使用 UTF-8；FreeType 从 /sdcard/font/font.ttf 加载中文字体。
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE=65536
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_FREETYPE=y
# CONFIG_LV_FREETYPE_USE_LVGL_PORT is not set

# SD 音乐目录允许使用中文长文件名，VFS 接口统一传递 UTF-8。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# 通过标准文件接口访问已挂载到 /sdcard 的 SD 卡。
CONFIG_LV_FS_DEFAULT_DRIVER_LETTER=83
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH=""
CONFIG_LV_FS_STDIO_CACHE_SIZE=4096

# 界面由应用程序创建，不编译 LVGL 示例和演示程序。
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
